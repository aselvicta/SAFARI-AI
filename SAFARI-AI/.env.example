SAFARI_STORE=memory
SAFARI_DATA_DIR=.data
DATABASE_URL=postgresql://safari:safari@localhost:5432/safari_ai

# OpenAI-compatible chat endpoint with tool calling. DeepSeek by default.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Approximate USD shown next to official TZS fees (TANAPA prices at 2,555 TZS/USD in 2026/27).
SAFARI_TZS_PER_USD=2555
# Hours between automatic refreshes of the TANAPA API data while the server runs (0 disables).
SAFARI_REFRESH_HOURS=12
# Required in the X-Admin-Token header for upload and harvest when set.
SAFARI_ADMIN_TOKEN=
