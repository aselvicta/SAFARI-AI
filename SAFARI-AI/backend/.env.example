SAFARI_STORE=memory
SAFARI_DATA_DIR=.data
DATABASE_URL=postgresql://safari:safari@localhost:5432/safari_ai

# DeepSeek writes the answers (RAG agent with tool calling, grounding and citation checks).
# The key alone turns it on; the endpoint and model below are the defaults. Without a key the
# desk answers from the template composer, and the admin dashboard raises a critical alert.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# TANAPA's billing rate: non-resident fees are USD x 2,555 in 2026/27, so their USD is exact. Other amounts
# convert at the live Bank of Tanzania rate; this value is only used if no live or saved rate exists.
SAFARI_TZS_PER_USD=2555
# Hours between automatic refreshes of the TANAPA API data while the server runs (0 disables).
SAFARI_REFRESH_HOURS=12
# Admin sign-in for the /admin dashboard. With these set, admins sign in with a username and password
# and get a session that lasts SAFARI_ADMIN_SESSION_HOURS. Changing the password signs everyone out.
SAFARI_ADMIN_USERNAME=
SAFARI_ADMIN_PASSWORD=
SAFARI_ADMIN_SESSION_HOURS=12
# Optional: a fixed key for signing sessions (otherwise derived from the credentials).
SAFARI_SECRET_KEY=
# Optional: a static token for scripts, sent as the X-Admin-Token header.
# With no password and no token set, admin is open to this machine only.
SAFARI_ADMIN_TOKEN=
# Optional: when the API sits behind a proxy (the Cloudflare Pages function in frontend/functions),
# requests to /v1 must carry this value in X-Proxy-Secret. Set the same value on both sides.
SAFARI_PROXY_SECRET=
